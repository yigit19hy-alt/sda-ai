/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), geolocation=(self), microphone=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/assets/*
  Cache-Control: public, max-age=604800

/assets/brand/*
  Access-Control-Allow-Origin: *

# Keep the Cloudflare preview addresses out of search results (only sda-services.ai is indexed)
https://sda-ai-f39.pages.dev/*
  X-Robots-Tag: noindex

https://:version.sda-ai-f39.pages.dev/*
  X-Robots-Tag: noindex

# Business card on the event page (/meet): open as a contact instead of plain text
/assets/sda-ai-services.vcf
  Content-Type: text/vcard; charset=utf-8
  Content-Disposition: attachment; filename="SDA-AI-Services.vcf"
